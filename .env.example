# ==========================================
# LegalAid Environment Configuration (.env)
# ==========================================

# Database Configuration (PostgreSQL)
# Python FastAPI service (SQLAlchemy + psycopg3 driver):
DATABASE_URL="postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-lively-darkness-aeziu72e-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Node.js Express Gateway (pg driver):
GATEWAY_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-lively-darkness-aeziu72e-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Inference (Groq Cloud)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Vector Search (Pinecone)
# Get a free key at: https://app.pinecone.io
PINECONE_API_KEY="pcsk_your_pinecone_api_key_here"
PINECONE_INDEX_NAME="legal-aid-documents"

# Authentication Security
# Must be at least 16 characters (recommended: 32+ char random hex string)
JWT_SECRET="replace-with-at-least-16-characters-secret-key"

# Service Routing & Ports
FASTAPI_BASE_URL="http://localhost:8000"
GATEWAY_PORT="3000"

# Frontend API Mode
# Set to "true" to query live backend API, or "false" to use mock data
VITE_USE_BACKEND_API="true"
