{
  "name": "legal-aid-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @legal-aid/web dev",
    "dev:backend": "pnpm --filter @legal-aid/backend dev",
    "dev:ai": "./services/ai/.venv/bin/uvicorn app.main:app --app-dir services/ai --host 0.0.0.0 --port 8000 --reload",
    "check": "./services/ai/.venv/bin/python scripts/check_system.py",
    "evals": "./services/ai/.venv/bin/python scripts/run_evals.py",
    "compare": "./services/ai/.venv/bin/python scripts/compare_findings.py",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

